# ==============================================================================
# GML AI Business Assistant v2.0 — Environment Configuration Example
# ==============================================================================

# Environment mode: development | staging | production
APP_ENV=development

# Data profile: real (Silver schema demo data) | synth (Synthetic generated data)
DATA_PROFILE=real

# As-of cut-off date (Default: 2026-07-31)
AS_OF_DATE=2026-07-31

# PostgreSQL Connection Strings - Real Profile
# Read-Only account for AI Querying (T1 DB Layer security)
POSTGRES_URI_RO=postgresql+psycopg2://gml_ai_ro:ro_secret@localhost:5432/gml
# Application account for operational logging (chat_turn, audit_log, alert_event)
POSTGRES_URI_APP=postgresql+psycopg2://gml_ai_app:app_secret@localhost:5432/gml
# Admin account used for migrations and schema creation
POSTGRES_URI_ADMIN=postgresql+psycopg2://postgres:postgres@localhost:5432/gml

# PostgreSQL Connection Strings - Synthetic Profile (Isolated database: gml_synth)
POSTGRES_URI_RO_SYNTH=postgresql+psycopg2://gml_ai_ro:ro_secret@localhost:5432/gml_synth
POSTGRES_URI_APP_SYNTH=postgresql+psycopg2://gml_ai_app:app_secret@localhost:5432/gml_synth
POSTGRES_URI_ADMIN_SYNTH=postgresql+psycopg2://postgres:postgres@localhost:5432/gml_synth

# LLM Configuration
# Provider: gemini | ollama | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
# Tier: free | paid
# WARNING (TC-T5-09): In production (APP_ENV=production), free tier cloud LLM is blocked!
LLM_TIER=free

# API Keys & Local Endpoints
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# API Security, Rate Limiting & Cache Settings (Phase 4 / T5)
# Static bearer tokens JSON string for production/custom deployments:
# Format: [{"token": "...", "user_id": "...", "role": "...", "display_name": "...", "expires_at": "..."}]
AUTH_TOKENS_JSON=
RATE_LIMIT_PER_MINUTE=60
KPI_CACHE_TTL_SECONDS=60
SESSION_TTL_DAYS=30
API_BASE_URL=http://127.0.0.1:8000
